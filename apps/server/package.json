{
  "name": "@kakashi/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node --env-file-if-exists=../../.env --import tsx dist/index.js"
  },
  "dependencies": {
    "express": "5.3.0",
    "cookie-parser": "1.4.7",
    "zod": "4.6.7",
    "@kakashi/contracts": "workspace:*",
    "@kakashi/rails": "workspace:*",
    "@kakashi/brain": "workspace:*",
    "@kakashi/trust": "workspace:*",
    "better-sqlite3": "13.0.3",
    "jose": "6.2.15"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "tsx": "4.23.15",
    "vitest": "5.1.0",
    "@types/express": "5.0.6",
    "@types/cookie-parser": "1.4.10",
    "supertest": "7.3.1",
    "@types/supertest": "7.2.1",
    "@types/better-sqlite3": "9.6.0"
  }
}
