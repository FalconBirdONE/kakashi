# Tollbooth environment (SPEC §7.9). No real values. Load with: node --env-file=.env ...

# ---- shared: rails + trust ----
HEDERA_NETWORK=hedera:testnet
ASSET_MODE=usdc                       # usdc | hbar (fallback)
USDC_TOKEN_ID=0.0.429274              # [CONFIRM] in spike S1
FACILITATOR_URL=https://x402.org/facilitator
FACILITATOR_FEEPAYER=0.0.9185802
AGENT_ACCOUNT_ID=
MERCHANT_QUICKCAST_PAYTO=
MERCHANT_HOURLYPRO_PAYTO=
MERCHANT_GROUNDTRUTH_PAYTO=
MERCHANT_GOUGER_PAYTO=

# ---- rails ----
HEDERA_OPERATOR_ID=                   # pays setup and HCS fees (server process)
HEDERA_OPERATOR_KEY=
HCS_TOPIC_ID=
MERCHANTS_URL=http://127.0.0.1:4200
MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com
SIGNER_URL=http://127.0.0.1:4100
SIGNER_MAX_PER_TX_ATOMIC=100000
SIGNER_MAX_TOTAL_ATOMIC=200000
# signer process ONLY (apps/signer/.env), never in the server's environment:
AGENT_PRIVATE_KEY=

# ---- trust + signer ----
PERMIT_SECRET=                        # 32 random bytes, hex

# ---- brain (0G) ----
ZG_BASE_URL=https://router-api.0g.ai/v1
ZG_API_KEY=
ZG_MODEL=
ZG_TRUST_MODE=private
ZG_VERIFY_TEE=true

# ---- trust (World) ----
WORLD_ISSUER=
WORLD_CLIENT_ID=
WORLD_CLIENT_SECRET=                  # server-side only
WORLD_REQUIRED_ACR=                   # optional
DB_PATH=./data/tollbooth.sqlite

# ---- app ----
DEMO_MODE=true                        # also read by rails
USE_REAL=                             # comma list of: rails,brain,trust
