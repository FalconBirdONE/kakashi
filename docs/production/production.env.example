# Template only. Fill secrets through the deployment environment, never commit real values.
NODE_ENV=production
DEMO_MODE=false
USE_REAL=rails,brain,trust
PAYMENTS_ENABLED=false
PRODUCTION_CHECKS_PASSED=false
PORT=4000
WEB_ROOT=/app/apps/web/dist
