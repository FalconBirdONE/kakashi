{
  "name": "@tollbooth/trust",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests",
    "coverage": "vitest run --coverage --coverage.provider=v8 --coverage.include=src/**",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@tollbooth/contracts": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "jose": "^6.2.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.1.0",
    "@types/better-sqlite3": "9.6.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  }
}
